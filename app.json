{
  "name": "Shop-it",
  "slug": "shopit",
  "version": "0.1.0",
  "orientation": "portrait",
  "icon": "./assets/icon.png",
  "userInterfaceStyle": "automatic",
  "scheme": "shopit",
  "ios": {
    "supportsTablet": true,
    "bundleIdentifier": "com.shopit.app"
  },
  "android": {
    "package": "com.shopit.app",
    "adaptiveIcon": {
      "foregroundImage": "./assets/adaptive-icon.png",
      "backgroundColor": "#ffffff"
    },
    "predictiveBackGestureEnabled": false
  },
  "web": {
    "favicon": "./assets/favicon.png"
  },
  "plugins": [
    "expo-router",
    "expo-secure-store",
    "expo-font",
    [
      "expo-splash-screen",
      {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff"
      }
    ],
    "expo-status-bar"
  ],
  "experiments": {
    "typedRoutes": true
  }
}
