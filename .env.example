# Shop-it environment variables. Copy this file to .env and fill in your values.
# Create a free project at https://supabase.com, then grab Project URL and anon (publishable) key:
# Supabase dashboard → Project Settings → Data API / API Keys.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
