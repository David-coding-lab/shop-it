{
  "name": "expo-starter",
  "version": "1.0.0",
  "description": "Production-ready Expo starter: Expo Router v6, Supabase auth, NativeWind, TypeScript strict mode",
  "keywords": [
    "expo",
    "expo-router",
    "react-native",
    "supabase",
    "nativewind",
    "starter",
    "template"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOUR_USERNAME/expo-starter.git"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.119.0",
    "expo": "~54.0.36",
    "expo-constants": "~18.0.14",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "nativewind": "^4.2.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "tailwindcss": "^3.4.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "typescript": "~5.9.2"
  },
  "private": true
}
